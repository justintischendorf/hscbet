{
  "name": "HSCBet",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint apps packages --fix",
    "check-types": "turbo run check-types",
    "format": "oxlint apps packages --fix-suggestions && oxfmt --write apps packages",
    "format:check": "oxfmt --check apps packages",
    "docker:dev": "docker compose -f docker-compose-dev.yml up --build -d",
    "docker:prod": "docker compose -f docker-compose-prod.yml up --build -d",
    "db:studio": "cd packages/database && bun prisma studio",
    "db:generate": "cd packages/database && bun prisma generate",
    "db:migrate:dev": "cd packages/database && bun prisma migrate dev",
    "db:migrate:reset": "cd packages/database && bunx prisma migrate reset --force",
    "db:seed": "bun scripts/seed.ts",
    "db:admin": "bun scripts/admin.ts"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
